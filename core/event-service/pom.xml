        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.mapstruct.version>1.6.3</project.mapstruct.version>
        <project.mapstruct.processor.version>1.6.3</project.mapstruct.processor.version>
        <project.lombok.version>1.18.38</project.lombok.version>
        <project.lombok.mapstruct.binding.version>0.2.0</project.lombok.mapstruct.binding.version>
